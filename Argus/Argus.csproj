<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform>AnyCPU</Platform>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>Argus</AssemblyName>
    <RootNamespace>Argus</RootNamespace>

    <!-- Let build.bat set KSP_DIR; fallback is project parent if not passed -->
    <KSP_DIR Condition=" '$(KSP_DIR)' == '' ">$([System.IO.Path]::GetFullPath('..'))</KSP_DIR>

    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Configuration-specific properties -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- KSP / Unity refs -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSP_DIR)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(KSP_DIR)\KSP_x64_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSP_DIR)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSP_DIR)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KSP_DIR)\KSP_x64_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KSP_DIR)\KSP_x64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- ToolbarControl reference -->
    <Reference Include="ToolbarControl">
      <HintPath>$(KSP_DIR)\GameData\001_ToolbarControl\Plugins\ToolbarControl.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- ClickThroughBlocker reference (required by ToolbarControl) -->
    <Reference Include="ClickThroughBlocker">
      <HintPath>$(KSP_DIR)\GameData\000_ClickThroughBlocker\Plugins\ClickThroughBlocker.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Framework refs resolved from v4.x reference assemblies -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ArgusMod.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- Import standard MSBuild targets -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- Optional: copy to GameData after a successful build -->
  <PropertyGroup>
    <GameDataDir>$(KSP_DIR)\GameData\Argus</GameDataDir>
    <PluginsDir>$(GameDataDir)\Plugins</PluginsDir>
    <IconsDir>$(GameDataDir)\Icons</IconsDir>
  </PropertyGroup>

  <Target Name="AfterBuild">
    <MakeDir Directories="$(PluginsDir)" />
    <MakeDir Directories="$(IconsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <!-- If your icon lives under repo Icons\argus_icon.png, copy it too -->
    <Copy Condition="Exists('Icons\argus_icon.png')"
          SourceFiles="Icons\argus_icon.png"
          DestinationFiles="$(IconsDir)\argus_icon.png" />
  </Target>
</Project>
